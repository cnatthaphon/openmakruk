{
  "name": "openmakruk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source Thai chess (Makruk) training platform — Thai-first, no backend, MIT-licensed",
  "license": "MIT",
  "author": "Natthaphon C.",
  "homepage": "https://openmakruk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnatthaphon/openmakruk.git"
  },
  "bugs": {
    "url": "https://github.com/cnatthaphon/openmakruk/issues"
  },
  "keywords": [
    "makruk",
    "thai-chess",
    "chess",
    "fairy-stockfish",
    "react",
    "vite",
    "typescript",
    "education",
    "training-platform"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --project=chromium",
    "deploy:check": "node scripts/deploy-check.mjs",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "fairy-stockfish-nnue.wasm": "^1.1.11",
    "ffish-es6": "^0.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
