{
  "name": "openmakruk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source Thai chess (Makruk) training platform — Thai-first, no backend, MIT-licensed",
  "license": "MIT",
  "author": "Natthaphon C.",
  "homepage": "https://openmakruk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnatthaphon/openmakruk.git"
  },
  "bugs": {
    "url": "https://github.com/cnatthaphon/openmakruk/issues"
  },
  "keywords": [
    "makruk",
    "thai-chess",
    "chess",
    "fairy-stockfish",
    "react",
    "vite",
    "typescript",
    "education",
    "training-platform"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js src worker/src worker/tests scripts",
    "lint:fix": "node node_modules/eslint/bin/eslint.js --fix src worker/src worker/tests scripts",
    "format": "node node_modules/prettier/bin/prettier.cjs --write 'src/**/*.{ts,tsx,css}' 'worker/src/**/*.ts' 'scripts/**/*.mjs'",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check 'src/**/*.{ts,tsx,css}' 'worker/src/**/*.ts' 'scripts/**/*.mjs'",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --project=chromium",
    "test:core": "node --experimental-strip-types --no-warnings --test 'src/core/__tests__/*.test.ts' 'src/lib/reviewPipeline/__tests__/*.test.ts' 'src/lib/journey/__tests__/*.test.ts'",
    "deploy:check": "node scripts/deploy-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/smoke.mjs https://openmakruk-api.cnatthaphon.workers.dev",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "fairy-stockfish-nnue.wasm": "^1.1.11",
    "ffish-es6": "^0.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
