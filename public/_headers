# Cloudflare Pages header rules — applied in order, first match wins
# for each header key.
#
# Cache strategy:
#   /assets/*       — content-addressed (hash in filename) → immutable
#   /pieces/*       — versioned by directory (makruk/ vs flat *.svg)
#                     → 30-day cache, still revalidate occasionally
#   /content/*.json — manifest-versioned content; the SW already does
#                     network-first, so a short browser cache is fine
#   /*.wasm         — versioned by npm package, never overwritten in
#                     place → immutable
#   default (/)     — must-revalidate so a deploy is picked up by
#                     repeat visitors without a hard reload
#
# Security headers:
#   COOP/COEP       — required for SharedArrayBuffer (multi-threaded
#                     Fairy-Stockfish WASM). Without it, the engine
#                     falls back to single-thread → 5× slower.
#   HSTS            — preload-eligible after 6 months at this max-age
#   Permissions-Policy — explicitly deny features we never use
#   CSP             — report-only first; tighten + enforce in v0.2
#                     once we've seen logs

# /sw.js MUST be first — the rule needs to win over both the generic
# /* security header rule (which carries no Cache-Control) and any
# Cloudflare Pages default. Bumping CACHE_VERSION in sw.js does nothing
# if browsers sit on a stale sw.js for hours per the default JS TTL.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/pieces/*
  Cache-Control: public, max-age=2592000

/content/*
  Cache-Control: public, max-age=300, must-revalidate

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), midi=()
  # Content Security Policy — enforcing mode (moved from
  # Content-Security-Policy-Report-Only on 2026-05-28 once the inline
  # script + style violations were eliminated).
  #
  # Each allowance is intentional:
  #   script-src 'self'              — only bundled chunks; no third-party scripts
  #              'wasm-unsafe-eval'  — required by WebAssembly.compile() for
  #                                    the Fairy-Stockfish engine WASM module
  #              'unsafe-eval'       — required by ffish-es6 (emscripten output
  #                                    that uses new Function() to bind WASM
  #                                    exports). Without it, the rules engine
  #                                    cannot load. Mitigations: no third-party
  #                                    scripts, no remote module loading, and
  #                                    our own code contains zero eval()/
  #                                    Function() calls (verified by ESLint
  #                                    `no-eval` + `no-new-func` rules).
  #              static.cloudflareinsights.com — first-party analytics shim
  #                                    Cloudflare injects automatically
  #   style-src  'unsafe-inline'     — chessground sets inline transform on
  #                                    every piece during drag/drop. Removing
  #                                    requires a chessground fork.
  #   img-src    data: blob:         — SVG piece sprites + share-image blobs
  #   connect-src                    — the openmakruk-api worker + jsDelivr
  #                                    for the NNUE network blob
  #   worker-src blob:               — Fairy-Stockfish runs in a Web Worker
  #                                    spawned from a Blob URL (Vite default)
  #   frame-ancestors 'none'         — clickjacking lockdown
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://openmakruk-api.cnatthaphon.workers.dev https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/
  Cache-Control: public, max-age=0, must-revalidate
